{
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "dev": true
    }
  },
  "crons": [
    {
      "path": "/api/cron/purge-deleted-accounts",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/purge-deleted-cabinets",
      "schedule": "0 4 * * *"
    }
  ]
}
