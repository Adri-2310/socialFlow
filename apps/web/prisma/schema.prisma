// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          String?   @default("CABINET_RH")
  sessions      Session[]
  accounts      Account[]

  twoFactorEnabled Boolean?    @default(false)
  twofactors       TwoFactor[]

  // Suspension d'un utilisateur individuel par un SuperAdmin (voir
  // api/admin/users/[id]/route.ts), distincte de l'archivage ci-dessous :
  // bloque uniquement ce compte, pas les autres membres de son cabinet
  // (contrairement a Cabinet.status qui suspend tout le cabinet). Meme
  // convention que Cabinet.status : string libre plutot qu'un enum Prisma.
  status      String  @default("actif") // actif | suspendu
  // Qui a pose la suspension (D52) : SUPER_ADMIN | CABINET_RH. Sert a (1)
  // n'autoriser la levee que par l'auteur (un Cabinet RH ne leve pas une
  // suspension du SuperAdmin) et (2) afficher le bon message a la connexion.
  // null avec status "suspendu" = suspension anterieure a ce champ, donc
  // forcement du SuperAdmin.
  suspendedBy String?

  // Archivage (au lieu d'une suppression definitive immediate) : la ligne
  // reste en base, toutes les sessions sont revoquees et toute nouvelle
  // connexion est bloquee (voir hooks.after dans auth.ts), jusqu'a purge
  // reelle (voir ACCOUNT_DELETION_RETENTION_DAYS et route
  // /api/cron/purge-deleted-accounts).
  deletedAt DateTime?
  // Qui a archive le compte (D52) : CABINET_RH | SUPER_ADMIN ; null =
  // auto-suppression par l'utilisateur. Un Cabinet RH ne peut restaurer que
  // ce qu'il a lui-meme retire (jamais une suppression voulue par la personne).
  deletedBy String?

  // RBAC (voir doc/analysis/ARCHITECTURE_SOCIALFLOW_RBAC.md) : un Cabinet RH
  // en cree un a l'inscription (hooks.after dans auth.ts) ; un utilisateur
  // invite (Gestionnaire RH...) recoit le cabinetId de l'invitation acceptee.
  // Nullable : SuperAdmin n'appartient a aucun cabinet.
  cabinetId       String?
  cabinet         Cabinet?     @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  sentInvitations Invitation[]

  // Raison sociale saisie a l'auto-inscription, utilisee une seule fois par
  // le hook pour nommer le Cabinet cree (voir additionalFields.cabinetName
  // dans auth.ts). Non reposee ensuite : le nom qui compte apres coup est
  // Cabinet.name.
  cabinetName String?

  entreprisesAssignees  GestionnaireEntreprise[]
  // Entreprise dont ce compte est l'administrateur (role ENTREPRISE_CLIENTE, D5).
  entrepriseAdministree Entreprise?              @relation("EntrepriseAdmin")

  // Dossier salarie lie a ce compte (portail Collaborateur, roles/03 § 4.3) et
  // conditions de travail saisies par ce compte.
  salarie              Salarie?
  conditionsCreees     ConditionTravail[]
  // Periodes ouvertes et prestations encodees par ce compte (D90, D92).
  periodesOuvertes     PeriodePaie[]
  prestationsModifiees Prestation[]
  baremesCrees         BaremeVersion[]    @relation("BaremeCreePar")
  baremesActives       BaremeVersion[]    @relation("BaremeActivePar")

  auditLogsAsActor  AuditLog[] @relation("AuditLogActor")
  auditLogsAsTarget AuditLog[] @relation("AuditLogTarget")

  @@unique([email])
  @@index([deletedAt])
  @@index([cabinetId])
  @@map("user")
}

model Cabinet {
  id                String             @id @default(cuid())
  name              String
  // Suspension par un SuperAdmin (voir apps/web/src/app/api/admin/cabinets/[id]
  // et le blocage de connexion associe dans hooks.after de auth.ts). Meme
  // convention que Invitation.status : string libre plutot qu'un enum
  // Prisma, coherent avec le reste du schema.
  status            String             @default("actif") // actif | suspendu
  // D71 : nature d'une suspension manuelle par le SuperAdmin. READ_ONLY (defaut
  // des nouvelles suspensions) = lecture seule, connexions possibles ; BLOCKED =
  // blocage total des connexions, choisi explicitement avec un motif. null avec
  // status "suspendu" = suspension anterieure a ce champ, donc blocage total
  // (comportement d'alors). Remis a null a la reactivation.
  // D75 : plan vise par un changement programme en fin de periode (D60). Tant
  // qu'il est en attente, les quotas de ce plan s'appliquent deja aux nouveaux
  // ajouts (le plus strict des deux). Efface quand le changement est applique,
  // annule, ou que la periode est renouvelee sans lui. null = aucun.
  pendingPlanId     String?
  // D76 : identifiant du portail de connexion du cabinet (/connexion/<slug>), par
  // lequel ses gestionnaires, entreprises et collaborateurs se connectent sans voir
  // SocialFlow. Genere a la demande puis modifiable par le Cabinet RH ; unique.
  slug              String?            @unique
  suspensionType    String?
  // Motif saisi par le SuperAdmin ; jamais montre aux clients du cabinet (D29).
  suspensionReason  String?
  // Archivage par un SuperAdmin (pas de vraie suppression : User.cabinetId a
  // onDelete: Cascade, supprimer reellement un Cabinet supprimerait tous ses
  // utilisateurs). Meme convention que User.deletedAt : bloque l'acces
  // immediatement (voir hooks.after de auth.ts), purge apres
  // CABINET_DELETION_RETENTION_DAYS (voir api/cron/purge-deleted-cabinets).
  deletedAt         DateTime?
  // D94 : purge partielle faite (comptes, invitations, branding supprimes). Reste la
  // coquille du cabinet, ses entreprises et ses donnees de paie, conservees 5 ans puis
  // supprimees par api/cron/purge-expired-retention. null = pas encore purge.
  donneesPurgeesLe  DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  // Identifiant du Customer Stripe correspondant (voir src/lib/stripe.ts et
  // /dashboard/admin/facturation) - null tant qu'aucun abonnement Stripe reel
  // n'a ete cree pour ce cabinet. Unique : un Customer Stripe par cabinet.
  stripeCustomerId  String?            @unique
  // Abonnement (D55) : le plan appartient au cabinet. Les transitions de
  // billingStatus viendront du webhook Stripe (chantier C0) ; pour l'instant
  // elles sont posees a l'inscription (voir lib/stripe-trial.ts).
  // planId = PricingPlan.planId ; billingPeriod : monthly | yearly ;
  // billingStatus : EN_ATTENTE_PAIEMENT | ESSAI | ACTIF | DELAI_GRACE | IMPAYE | RESILIE.
  planId            String?
  billingPeriod     String?
  billingStatus     String             @default("EN_ATTENTE_PAIEMENT")
  trialEndsAt       DateTime?
  currentPeriodEnd  DateTime?
  // D57 : debut du delai de grace (paiement echoue), null hors impaye ; et
  // date du dernier evenement Stripe applique (un evenement plus ancien est
  // ignore, les webhooks pouvant arriver dans le desordre).
  pastDueSince      DateTime?
  // Resiliation programmee en fin de periode (D59) : le cabinet garde l'acces
  // jusqu'a currentPeriodEnd. Suit Stripe par webhook, jamais l'inverse.
  cancelAtPeriodEnd Boolean            @default(false)
  // Identite du cabinet (D30), affichee a ses clients. name = raison sociale.
  // Tous facultatifs sauf la raison sociale : le n° de TVA est stocke au
  // format canonique BE0XXX.XXX.XXX (voir lib/cabinet-identity.ts).
  vatNumber         String?
  addressLine       String?
  postalCode        String?
  city              String?
  country           String             @default("BE")
  contactEmail      String?
  contactPhone      String?
  // Branding (D33, D62) : nom affiche et couleurs #rrggbb. null = valeurs par
  // defaut de SocialFlow.
  displayName       String?
  primaryColor      String?
  secondaryColor    String?
  // Logo (D33, D62) : image publique stockee hors base (Vercel Blob). logoPath
  // sert a la supprimer quand le logo est remplace ou retire.
  logoUrl           String?
  logoPath          String?
  billingEventAt    DateTime?
  users             User[]
  invitations       Invitation[]
  auditLogs         AuditLog[]
  emailTemplates    EmailTemplate[]
  entreprises       Entreprise[]
  salaries          Salarie[]
  conditionsTravail ConditionTravail[]
  periodesPaie      PeriodePaie[]
  prestations       Prestation[]

  @@index([deletedAt])
  @@map("cabinet")
}

// Entreprise cliente d'un cabinet (D4, roles/02-cabinet-rh.md § 4.3). Le n°
// d'entreprise (format canonique BE0XXX.XXX.XXX) est unique dans le cabinet,
// archivees comprises : on ne recree pas une entreprise archivee, on la
// restaure. deletedAt = archivage (soft-delete, fiches conservees 5 ans).
model Entreprise {
  id                    String                   @id @default(cuid())
  cabinetId             String
  // D94 : Restrict, l'entreprise porte les donnees de paie a conserver 5 ans.
  cabinet               Cabinet                  @relation(fields: [cabinetId], references: [id], onDelete: Restrict)
  name                  String
  vatNumber             String
  addressLine           String?
  postalCode            String?
  city                  String?
  country               String                   @default("BE")
  contactEmail          String?
  contactPhone          String?
  // D46, D91 : jour du mois (1 a 28) avant lequel l'entreprise donne ses prestations ; regle par
  // le Cabinet RH, decalable par le gestionnaire pour une periode. 20 par defaut.
  jourLimitePrestations Int                      @default(20)
  deletedAt             DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  gestionnaires         GestionnaireEntreprise[]
  salaries              Salarie[]
  periodesPaie          PeriodePaie[]

  // D5 : un seul compte administrateur par entreprise. Renseigne a l'acceptation
  // de l'invitation ; @unique garantit qu'un compte n'administre qu'une
  // entreprise (D7). SetNull : si le compte est purge, l'entreprise redevient
  // sans administrateur et peut en inviter un nouveau.
  adminUserId String?      @unique
  adminUser   User?        @relation("EntrepriseAdmin", fields: [adminUserId], references: [id], onDelete: SetNull)
  invitations Invitation[]

  @@unique([cabinetId, vatNumber])
  @@index([cabinetId, deletedAt])
  @@map("entreprise")
}

// Assignation N:M gestionnaire <-> entreprise (D4, D27). Un gestionnaire ne
// travaille que sur les entreprises qui lui sont assignees.
model GestionnaireEntreprise {
  entrepriseId String
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([entrepriseId, userId])
  @@index([userId])
  @@map("gestionnaire_entreprise")
}

// Dossier salarie (D6, roles/03 § 4). NISS et IBAN sont chiffres (AES-256-GCM,
// lib/crypto) ; nissHash est une empreinte liee a l'entreprise qui garantit
// l'unicite du NISS par entreprise sans le stocker en clair. Archives comprises :
// on restaure un dossier plutot que d'en recreer un (comme le n° d'entreprise,
// D69). Pas de suppression physique : deletedAt = archivage, conservation 5 ans.
// Statuts en chaines MAJUSCULES sans accent, valeurs validees par
// lib/schemas/salarie.ts (pas d'enum Prisma, CONVENTIONS § 4).
model Salarie {
  id           String     @id @default(cuid())
  // D94 : Restrict sur le cabinet et l'entreprise, le dossier est conserve 5 ans.
  cabinetId    String
  cabinet      Cabinet    @relation(fields: [cabinetId], references: [id], onDelete: Restrict)
  entrepriseId String
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Restrict)

  // Identite
  nom           String
  prenom        String
  dateNaissance DateTime @db.Date
  adresse       String?
  codePostal    String?
  ville         String?
  pays          String   @default("BE")
  email         String?
  nissEncrypted String
  nissHash      String
  ibanEncrypted String

  // Contrat (le statut, la CP, la fonction et la remuneration sont dates :
  // voir ConditionTravail)
  typeContrat    String // CDI | CDD
  dateEntree     DateTime  @db.Date
  dateFinContrat DateTime? @db.Date
  dateSortie     DateTime? @db.Date

  // Fiscal (precompte professionnel, D95, Annexe III 2026) : des criteres, jamais un montant.
  // Non date (D83). Valeurs validees par lib/schemas/salarie.ts, coherence dans checkFiscal.
  situationFamiliale        String // ISOLE | MARIE_OU_COHABITANT_LEGAL (situation fiscale, n° 4)
  // Null pour un isole. SANS_REVENUS | PENSION_TRES_LIMITEE | PENSION_LIMITEE | REVENU_LIMITE | REVENUS
  conjointRevenus           String?
  beneficiaireHandicape     Boolean  @default(false)
  conjointHandicape         Boolean  @default(false)
  enfantsCharge             Int      @default(0)
  enfantsHandicapes         Int      @default(0) // sous-ensemble de enfantsCharge
  autresChargeDependantes66 Int      @default(0) // n° 9 et 39 : dependantes de 66 ans ou plus
  autresChargeHandicapees   Int      @default(0)
  autresCharge              Int      @default(0)
  parentIsole               Boolean  @default(false) // n° 40.1
  // n° 6 : qui des deux conjoints recoit les reductions. Null = a preciser (le moteur refuse de calculer).
  chargesFamilleAttribuees  Boolean?
  // Obsoletes depuis D95, conservees jusqu'au moteur de paie (G2a) : remplacees par
  // conjointRevenus et enfantsCharge, dont la migration a repris les valeurs.
  conjointAvecRevenus       Boolean?
  personnesCharge           Int      @default(0)

  // Compte du portail Collaborateur (facultatif, D12). SetNull : si le compte est
  // purge, le dossier reste (obligation de conservation).
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  deletedAt   DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  conditions  ConditionTravail[]
  prestations Prestation[]
  // Invitations au portail Collaborateur envoyees pour ce dossier (une seule en attente a la fois).
  invitations Invitation[]

  @@unique([entrepriseId, nissHash])
  @@index([cabinetId])
  @@index([entrepriseId, deletedAt])
  @@index([deletedAt])
  @@map("salarie")
}

// Historique date des conditions de travail d'un salarie (roles/03 § 4.2) : une
// ligne par changement de statut, regime, fonction ou remuneration. Une fiche
// utilise la condition en vigueur a sa periode : la plus recente dont dateEffet
// ne depasse pas la periode. On n'edite jamais une ligne deja utilisee : on en
// ajoute une nouvelle. Montants en centimes.
model ConditionTravail {
  id        String   @id @default(cuid())
  // D94 : Restrict, voir Salarie.
  cabinetId String
  cabinet   Cabinet  @relation(fields: [cabinetId], references: [id], onDelete: Restrict)
  salarieId String
  salarie   Salarie  @relation(fields: [salarieId], references: [id], onDelete: Restrict)
  dateEffet DateTime @db.Date

  statut                  String // EMPLOYE | OUVRIER (D39)
  commissionParitaire     String // 200 | 100 (D44)
  fonction                String
  regime                  String // TEMPS_PLEIN | TEMPS_PARTIEL
  // Fraction d'occupation = heuresSemaineMinutes / heuresReferenceMinutes (non stockee). D96 :
  // minutes entieres par semaine, jamais de flottant pour une duree.
  heuresSemaineMinutes    Int?
  heuresReferenceMinutes  Int?
  // Employe : salaire mensuel ; ouvrier : salaire horaire.
  salaireMensuelBrutCents Int?
  salaireHoraireBrutCents Int?

  // SetNull : le compte de l'auteur peut etre purge, la condition reste.
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@unique([salarieId, dateEffet])
  @@index([cabinetId])
  @@map("condition_travail")
}

// Periode de paie d'une entreprise (D90, roles/03 § 5) : un mois, unique par entreprise. Le
// gestionnaire assigne l'ouvre ; les prestations s'encodent tant qu'elle est OUVERTE et se
// figent a la VERROUILLEE (statuts en chaines, valeurs validees par lib/schemas/periode.ts).
// dateLimite (D91) est calculee a l'ouverture depuis Entreprise.jourLimitePrestations et
// peut etre decalee pour cette seule periode. Pas de suppression : une periode ouverte par
// erreur reste, vide, et se verrouille.
model PeriodePaie {
  id           String     @id @default(cuid())
  // D94 : Restrict, voir Salarie.
  cabinetId    String
  cabinet      Cabinet    @relation(fields: [cabinetId], references: [id], onDelete: Restrict)
  entrepriseId String
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Restrict)

  annee      Int
  mois       Int // 1 a 12
  statut     String // OUVERTE | VERROUILLEE
  dateLimite DateTime @db.Date

  // SetNull : le compte peut etre purge, la periode reste.
  ouverteParId  String?
  ouvertePar    User?        @relation(fields: [ouverteParId], references: [id], onDelete: SetNull)
  verrouilleeLe DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  prestations   Prestation[]

  @@unique([entrepriseId, annee, mois])
  @@index([cabinetId])
  @@map("periode_paie")
}

// Ecarts de prestations d'un salarie pour une periode (D92, roles/03 § 5) : un salarie sans
// ligne vaut « mois complet selon son regime ». Aucun flottant : les jours se comptent en
// demi-journees (2 = un jour), les heures en minutes, la prime en centimes. Les limites
// (jours d'un mois, heures d'un mois) sont verifiees par lib/schemas/prestation.ts.
model Prestation {
  id        String      @id @default(cuid())
  // D94 : Restrict, voir Salarie.
  cabinetId String
  cabinet   Cabinet     @relation(fields: [cabinetId], references: [id], onDelete: Restrict)
  periodeId String
  periode   PeriodePaie @relation(fields: [periodeId], references: [id], onDelete: Restrict)
  salarieId String
  salarie   Salarie     @relation(fields: [salarieId], references: [id], onDelete: Restrict)

  heuresPresteesMinutes  Int? // facultatif, utile surtout aux ouvriers
  congeDemiJours         Int     @default(0)
  maladieDemiJours       Int     @default(0)
  ferieDemiJours         Int     @default(0)
  absenceNonRemDemiJours Int     @default(0)
  heuresSupMinutes       Int     @default(0)
  primeCents             Int?
  primeLibelle           String?

  // Qui a encode en dernier (le gestionnaire voit qui a encode quoi). SetNull : compte purge.
  modifieParId String?
  modifiePar   User?    @relation(fields: [modifieParId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([periodeId, salarieId])
  @@index([cabinetId])
  @@index([salarieId])
  @@map("prestation")
}

// Version datee des parametres legaux du moteur de paie (D99, D22, modules/paie.md § 5).
// Table GLOBALE, sans cabinetId : un bareme n'est pas une donnee de paie (D8), il est le
// meme pour tous les cabinets. Les parametres sont des entiers (centimes, dix-milliemes) et
// valides par lib/payroll/bareme/schema.ts ; chaque bloc cite sa source. Statuts en chaines
// MAJUSCULES (A_VERIFIER | ACTIF | RETIRE). Une seule version ACTIF par mois et par categorie
// d'employeur (D98) : Prisma n'exprime pas cette contrainte, elle est verifiee par
// lib/payroll/bareme/choisir.ts et le sera a l'activation (chantier F).
model BaremeVersion {
  id                 String    @id @default(cuid())
  code               String    @unique // "BE-2026-01"
  valideDepuis       DateTime  @db.Date
  valideJusqua       DateTime? @db.Date // null = sans fin
  statut             String
  categorieEmployeur String // D98, ex. PRIVE_MARCHAND
  parametres         Json
  source             Json

  // SetNull : le compte peut etre purge, le bareme reste.
  creeParId   String?
  creePar     User?     @relation("BaremeCreePar", fields: [creeParId], references: [id], onDelete: SetNull)
  activeParId String?
  activePar   User?     @relation("BaremeActivePar", fields: [activeParId], references: [id], onDelete: SetNull)
  activeLe    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([statut, valideDepuis])
  @@map("bareme_version")
}

// Modele d'email personnalise d'un cabinet (D30, D68). Absent = modele par
// defaut de SocialFlow (voir lib/email-templates.ts). Un seul modele par type et
// par cabinet.
model EmailTemplate {
  id          String   @id @default(cuid())
  cabinetId   String
  cabinet     Cabinet  @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  type        String
  subject     String
  body        String
  updatedAt   DateTime @updatedAt
  updatedById String?

  @@unique([cabinetId, type])
  @@map("email_template")
}

// Journal d'audit global consulte par le dashboard SuperAdmin (voir
// doc/analysis/ARCHITECTURE_SOCIALFLOW_RBAC.md, SPEC_FINAL.md section
// MONITORING & ADMIN). Alimente uniquement par les actions construites au fil
// des passes (pas d'historique retroactif). SetNull plutot que Cascade sur
// toutes les relations : un log d'audit doit survivre a la suppression de son
// acteur, du cabinet ou de l'utilisateur concerne, c'est le principe meme
// d'un audit trail. targetUserId distinct de actorId : necessaire pour les
// actions USER_* (qui/quoi a ete modifie) independamment de cabinetId (qui
// ne s'applique qu'aux actions CABINET_*).
model AuditLog {
  id           String   @id @default(cuid())
  action       String // CABINET_CREATED | CABINET_SUSPENDED | CABINET_REACTIVATED | CABINET_ARCHIVED | CABINET_RESTORED | USER_ARCHIVED | USER_RESTORED | PRICING_PLAN_CREATED | PRICING_PLAN_UPDATED | PRICING_PLAN_ARCHIVED | PRICING_PLAN_RESTORED
  actorId      String?
  actor        User?    @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)
  cabinetId    String?
  cabinet      Cabinet? @relation(fields: [cabinetId], references: [id], onDelete: SetNull)
  targetUserId String?
  targetUser   User?    @relation("AuditLogTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  // Contexte de l'action (ex. { invitationId, email }) ; jamais de donnee de paie.
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@map("audit_log")
}

// Invitation par email (voir doc/analysis/ARCHITECTURE_SOCIALFLOW_RBAC.md
// section 4). Premiere iteration : uniquement Cabinet RH -> Gestionnaire RH,
// le modele reste generique pour les invitations Entreprise/Collaborateur a
// venir.
model Invitation {
  id              String      @id @default(cuid())
  email           String
  role            String
  // sha256 (hex) du jeton envoye par email ; le jeton en clair n'est jamais
  // stocke (voir lib/invitations.ts, C3).
  tokenHash       String      @unique
  status          String      @default("pending") // pending | accepted | expired | revoked
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime    @default(now())
  cabinetId       String
  cabinet         Cabinet     @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  invitedById     String
  invitedBy       User        @relation(fields: [invitedById], references: [id], onDelete: Cascade)
  // Invitation ENTREPRISE_CLIENTE (D4, D5) : l'entreprise dont la personne
  // deviendra l'administrateur. null pour une invitation de gestionnaire.
  entrepriseId    String?
  entreprise      Entreprise? @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  // D78 : invitation de REMPLACEMENT - l'administrateur en place au moment de l'envoi. Il
  // reste actif jusqu'a l'acceptation, qui l'archive dans la meme transaction. null pour
  // une premiere invitation. Pas de cle etrangere : l'id sert de preuve que l'admin n'a
  // pas change entre-temps.
  replacesAdminId String?
  // Invitation COLLABORATEUR (roles/03 § 4.3) : le dossier salarie que le compte rejoindra, lie a
  // l'acceptation (Salarie.userId). null pour une invitation de gestionnaire ou d'administrateur
  // d'entreprise. Cascade : si le dossier disparait, l'invitation n'a plus d'objet.
  salarieId       String?
  salarie         Salarie?    @relation(fields: [salarieId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([entrepriseId])
  @@index([salarieId])
  @@map("invitation")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  // Namespace introduit par better-auth 1.7 pour distinguer les methodes
  // d'authentification sans issuer OIDC reel (ex: "local:credential",
  // "local:oauth:google") ; backfill des comptes existants dans la migration.
  issuer                String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model PricingPlan {
  id              String    @id @default(cuid())
  planId          String    @unique
  name            String
  description     String
  monthlyPrice    Int?
  yearlyPrice     Int?
  highlighted     Boolean   @default(false)
  badge           String?
  features        String[]
  sortOrder       Int       @default(0)
  // Quotas bloquants (D15, valeurs par defaut en D34) ; null = illimite.
  // maxUtilisateurs = Cabinet RH + gestionnaires ; maxStorageMb en Mo.
  maxEntreprises  Int?
  maxUtilisateurs Int?
  maxStorageMb    Int?
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("pricing_plan")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

// Stockage persistant du rate limiter better-auth (rateLimit.storage:
// 'database' dans auth.ts). Schema et nom de modele imposes par better-auth
// (le model "rateLimit" est reference en dur dans
// dist/api/rate-limiter/index.mjs, non personnalisable) - sans cette table,
// les compteurs vivaient en memoire et repartaient de zero a chaque cold
// start Vercel (voir doc/analysis/AUDIT_SECURITE_AUTH.md, finding #3).
model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rate_limit")
}

// Evenements Stripe deja recus (D57) : l'identifiant unique garantit qu'un
// evenement rejoue par Stripe n'a pas d'effet double. processedAt reste null
// tant que le traitement n'a pas abouti, pour qu'un nouvel envoi le reprenne.
model WebhookEvent {
  id          String    @id @default(cuid())
  eventId     String    @unique
  type        String
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@map("webhook_event")
}
