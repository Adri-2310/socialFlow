// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          String?   @default("CABINET_RH")
  plan          String?
  billingPeriod String?
  sessions      Session[]
  accounts      Account[]

  twoFactorEnabled Boolean?    @default(false)
  twofactors       TwoFactor[]

  // Archivage (au lieu d'une suppression definitive immediate) : la ligne
  // reste en base, toutes les sessions sont revoquees et toute nouvelle
  // connexion est bloquee (voir hooks.after dans auth.ts), jusqu'a purge
  // reelle apres 30 jours (voir route /api/cron/purge-deleted-accounts) ou
  // restauration manuelle (scripts/restore-account.ts).
  deletedAt DateTime?

  // RBAC (voir doc/analysis/ARCHITECTURE_SOCIALFLOW_RBAC.md) : un Cabinet RH
  // en cree un a l'inscription (hooks.after dans auth.ts) ; un utilisateur
  // invite (Gestionnaire RH...) recoit le cabinetId de l'invitation acceptee.
  // Nullable : SuperAdmin n'appartient a aucun cabinet.
  cabinetId       String?
  cabinet         Cabinet?     @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  sentInvitations Invitation[]

  // Raison sociale saisie a l'auto-inscription, utilisee une seule fois par
  // le hook pour nommer le Cabinet cree (voir additionalFields.cabinetName
  // dans auth.ts). Non reposee ensuite : le nom qui compte apres coup est
  // Cabinet.name.
  cabinetName String?

  auditLogs AuditLog[]

  @@unique([email])
  @@index([deletedAt])
  @@index([cabinetId])
  @@map("user")
}

model Cabinet {
  id          String       @id @default(cuid())
  name        String
  // Suspension par un SuperAdmin (voir apps/web/src/app/api/admin/cabinets/[id]
  // et le blocage de connexion associe dans hooks.after de auth.ts). Meme
  // convention que Invitation.status : string libre plutot qu'un enum
  // Prisma, coherent avec le reste du schema.
  status      String       @default("actif") // actif | suspendu
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  users       User[]
  invitations Invitation[]
  auditLogs   AuditLog[]

  @@map("cabinet")
}

// Journal d'audit global consulte par le dashboard SuperAdmin (voir
// doc/analysis/ARCHITECTURE_SOCIALFLOW_RBAC.md, SPEC_FINAL.md section
// MONITORING & ADMIN). Alimente uniquement par les actions construites au fil
// des passes (pas d'historique retroactif). SetNull plutot que Cascade sur
// les deux relations : un log d'audit doit survivre a la suppression de son
// acteur ou du cabinet concerne, c'est le principe meme d'un audit trail.
model AuditLog {
  id        String   @id @default(cuid())
  action    String   // CABINET_CREATED | CABINET_SUSPENDED | CABINET_REACTIVATED
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  cabinetId String?
  cabinet   Cabinet? @relation(fields: [cabinetId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("audit_log")
}

// Invitation par email (voir doc/analysis/ARCHITECTURE_SOCIALFLOW_RBAC.md
// section 4). Premiere iteration : uniquement Cabinet RH -> Gestionnaire RH,
// le modele reste generique pour les invitations Entreprise/Collaborateur a
// venir.
model Invitation {
  id          String    @id @default(cuid())
  email       String
  role        String
  token       String    @unique
  status      String    @default("pending") // pending | accepted | expired | revoked
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
  cabinetId   String
  cabinet     Cabinet   @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  invitedById String
  invitedBy   User      @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([token])
  @@map("invitation")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model PricingPlan {
  id           String   @id @default(cuid())
  planId       String   @unique
  name         String
  description  String
  monthlyPrice Int?
  yearlyPrice  Int?
  custom       Boolean  @default(false)
  highlighted  Boolean  @default(false)
  badge        String?
  features     String[]
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("pricing_plan")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

// Stockage persistant du rate limiter better-auth (rateLimit.storage:
// 'database' dans auth.ts). Schema et nom de modele imposes par better-auth
// (le model "rateLimit" est reference en dur dans
// dist/api/rate-limiter/index.mjs, non personnalisable) - sans cette table,
// les compteurs vivaient en memoire et repartaient de zero a chaque cold
// start Vercel (voir doc/analysis/AUDIT_SECURITE_AUTH.md, finding #3).
model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rate_limit")
}
